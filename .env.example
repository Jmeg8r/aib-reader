# aib-reader environment configuration (example).
# Copy to `.env` and adjust. v1 has NO secrets (local SQLite, local-stdio MCP);
# this file documents the optional config knobs only. `.env` is gitignored.

# Where the SQLite store lives. Default: ~/.aib-reader/store.db
# AIB_READER_DB_PATH=~/.aib-reader/store.db

# Path to the canonical feed list. Default: config/feeds.yaml
# AIB_READER_FEEDS_CONFIG=config/feeds.yaml

# Log level: DEBUG | INFO | WARNING | ERROR. Default: INFO
# AIB_READER_LOG_LEVEL=INFO

# User-Agent sent when fetching feeds (be a polite citizen).
# AIB_READER_USER_AGENT=aib-reader/0.0.1 (+https://github.com/jmeg8r/aib-reader)

# Fetch tuning (v0.0b).
# AIB_READER_FETCH_CONCURRENCY=10
# AIB_READER_FETCH_TIMEOUT=20
# First-fetch flood cap: only ingest items newer than this many days on a feed's first poll.
# AIB_READER_FIRST_FETCH_HORIZON_DAYS=14
