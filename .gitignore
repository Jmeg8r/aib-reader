# --- Secrets FIRST (never commit credentials) ---
.env
.env.*
!.env.example
*.key
*.pem
secrets.*
config/secrets.yaml

# --- PERSONAL feed list — never commit (this repo is public) ---
# config/feeds.yaml is the user's private subscription list (politics/veteran/health/
# location). The repo ships config/feeds.yaml.example only; users generate their own
# via `aib-reader import-opml <their-export.opml>`. Purged from history 2026-06-03.
config/feeds.yaml
*.opml
!tests/fixtures/*.opml

# --- Local runtime data (the SQLite store lives in the user's home) ---
# ~/.aib-reader/store.db is outside the repo, but ignore any local copies:
*.db
*.db-journal
*.db-wal
*.db-shm
.aib-reader/
data/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.Python

# --- uv / venv ---
.venv/
venv/
# uv.lock IS committed (reproducible installs) — do not ignore it.

# --- Local generated logs (robustness-gate sample, launchd output) ---
tasks/robustness-gate.log
launchd-*.log

# --- Test / coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Editor / OS ---
.DS_Store
.idea/
.vscode/
*.swp
